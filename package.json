{
  "name": "ai-gateway",
  "version": "2.0.0",
  "description": "Multi-LLM parallel inference system with direct API integration and webview scraping fallback",
  "main": "main.js",
  "author": "AI Gateway Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "npm run build:mac && npm run build:win && npm run build:linux",
    "build:mac": "electron-builder --platform=darwin --arch=x64,arm64",
    "build:win": "electron-builder --platform=win32 --arch=x64",
    "build:linux": "electron-builder --platform=linux --arch=x64",
    "package": "electron-builder",
    "dev": "NODE_ENV=development electron .",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "electron": "^28.0.0",
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.1",
    "jest": "^29.7.0"
  },
  "build": {
    "appId": "com.aigateway.app",
    "productName": "AI Gateway",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "api-service.js",
      "ui/**/*",
      "package.json"
    ],
    "mac": {
      "category": "PublicUtility",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "category": "Utility"
    }
  }
}
